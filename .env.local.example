# Copy this file to .env.local (already gitignored) and fill in real values.

# Required for receipt scanning (POST /api/scan-receipt). Create a key at
# https://console.anthropic.com/settings/keys — server-side only, never expose
# this to the client.
ANTHROPIC_API_KEY=

# Required for the database (users/accounts) and drizzle-kit migrations. Create a Neon project
# via the Vercel Marketplace and use the pooled connection string it gives you.
DATABASE_URL=

# Required by Auth.js to encrypt session JWTs. Generate one with `npx auth secret`
# (writes it straight into .env.local) or `openssl rand -base64 33`.
AUTH_SECRET=

# Required for "Sign in with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (add the production URL too once deployed).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
